# Copy to .env and fill in.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/whatslocal2_0?retryWrites=true&w=majority
PORT=9100
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5180
REVEAL_ANON_LIMIT=3
REVEAL_DAILY_LIMIT=5
DEFAULT_OTP=1234
INFLATE_MULTIPLIER=7.63
INFLATE_BASE=0
# MSG91 OTP — set the account Auth Key to switch from the demo OTP to real OTP.
# SECRET — server only, never commit a real value. When unset, login uses DEFAULT_OTP.
MSG91_AUTH_KEY=
